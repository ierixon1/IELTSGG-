node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Credentials the dev server writes: `users.json` holds password hashes and
# `sessions.json` holds live session tokens. These stay out of the repository
# regardless of whether it is public or private — anything pushed to a public
# repo is already mirrored and cached, and going private later does not undo
# that. `db.json` is the legacy single-user store the server recreates on boot.
data/users.json
data/sessions.json
data/db.json
data/uploads/
data/ai_usage_log.json
data/ai_quota.json
data/request_rate_limits.json

# The project's lockfile is bun.lock; a second lockfile from a local npm
# install would only fight with it.
package-lock.json
