# ===============================
# Core AI configuration
# ===============================
GEMINI_API_KEY=""
APP_URL="https://your-production-domain.example"

# ===============================
# Storage
# ===============================
# local is for explicit local development only.
# Production should use gcs_firestore.
STORAGE_BACKEND="gcs_firestore"
GCS_BUCKET_NAME=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ===============================
# Development-only authentication
# ===============================
# Keep FALSE in production. This enables the x-user-id development header.
EXPLICIT_DEV_AUTH="false"

# ===============================
# Admin bootstrap (optional)
# ===============================
# Defaults are intentionally NOT provided.
# SEED_DEFAULT_ACCOUNTS should only be used during a controlled bootstrap.
SEED_DEFAULT_ACCOUNTS="false"
ADMIN_USER=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
EXAMINER_EMAIL=""
EXAMINER_SEED_PASSWORD=""

# ===============================
# Public-service limits
# ===============================
RATE_LIMIT_GENERATIONS=10
RATE_LIMIT_UPLOADS=3
