# Settings marked [production] are required when NODE_ENV=production: the server
# checks them before anything else loads and refuses to start, listing every
# problem, until they are set. See README, Deployment.

# ===============================
# Server
# ===============================
# production switches on the production checks. Leave empty for local development.
NODE_ENV=""
# [production] The port to listen on. Cloud Run and most platforms set it for you.
# Outside production an unset PORT is 3000.
PORT=""

# ===============================
# Core AI configuration
# ===============================
GEMINI_API_KEY=""

# ===============================
# Email delivery (password reset)
# ===============================
# [production] Resend API configuration. Keep the API key server-side only.
RESEND_API_KEY=""
EMAIL_FROM="PrepIELTS <no-reply@your-domain.example>"
# [production] The https:// address learners open the app at; reset links point here.
APP_URL="https://your-production-domain.example"

# ===============================
# Storage
# ===============================
# local is for explicit local development only.
# [production] gcs_firestore.
STORAGE_BACKEND="gcs_firestore"
# [production] The Cloud Storage bucket uploaded files are kept in.
GCS_BUCKET_NAME=""
# Firestore credentials: all three (a service-account key; write line breaks in
# the key as \n), or none of the key's parts to use Application Default
# Credentials (the platform's service account, or GOOGLE_APPLICATION_CREDENTIALS
# naming a key file, which must exist).
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Once per Firestore project, let Firestore delete rate-limit documents after
# their window closes (they carry expiresAt):
#   gcloud firestore fields ttls update expiresAt --collection-group=rate_limits --enable-ttl --project=<project>

# ===============================
# Client addresses behind a proxy
# ===============================
# Rate limits for requests without a session (sign-up, sign-in, password
# recovery, anonymous API calls) are counted per client address; signed-in
# learners and staff are counted per account.
# [production] Say what sits in front of the server: the number of proxy hops
# (Cloud Run, or one load balancer or nginx: 1), a comma-separated list of proxy
# addresses/CIDR ranges, or false when clients connect directly. Outside
# production, empty means false. "true" is refused: it would let any client
# choose its own address.
TRUST_PROXY=""

# ===============================
# Development-only authentication
# ===============================
# Keep FALSE. This enables the x-user-id development header. It works only with
# NODE_ENV=development or test; with NODE_ENV unset or anything else (production
# included) the server refuses to start.
EXPLICIT_DEV_AUTH="false"

# ===============================
# Admin bootstrap
# ===============================
# SEED_DEFAULT_ACCOUNTS seeds the local development store only, and is refused in
# production. Defaults are intentionally NOT provided.
ADMIN_USER=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
EXAMINER_EMAIL=""
EXAMINER_SEED_PASSWORD=""

# ===============================
# Public-service limits
# ===============================
RATE_LIMIT_GENERATIONS=10
RATE_LIMIT_UPLOADS=3

# The first administrator, on either store: register the account in the app, set
# the username here, start the server once, then remove these lines again. The
# account's sessions end and it signs in again with the new role. The same is done
# from a checkout with: npm run admin:promote -- <username> [admin|examiner]
# ADMIN_PROMOTE_ROLE accepts admin or examiner.
ADMIN_PROMOTE_USERNAME=""
ADMIN_PROMOTE_ROLE="admin"
